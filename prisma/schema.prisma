// Lumi гоо сайхны дэлгүүрийн өгөгдлийн загвар
// Production: PostgreSQL (Neon). DATABASE_URL орчны хувьсагчаар холбоно.
// role/status-г String-ээр хадгална (хялбар, шилжихэд эвтэйхэн).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       String    @id @default(cuid())
  name     String // жишээ: "Арьс арчилгаа"
  slug     String    @unique
  image    String?
  products Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String // жишээ: "The Ordinary"
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Int // үнэ ₮ (бүхэл тоо)
  image       String
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?      @relation(fields: [brandId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // "USER" | "ADMIN"
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    String      @default("PENDING") // PENDING | PAID | SHIPPED | DELIVERED | CANCELLED
  total     Int
  // Хүргэлтийн мэдээлэл
  fullName  String
  phone     String
  address   String
  note      String?
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // снапшот (бараа устгагдсан ч захиалга бүрэн байх)
  price     Int // снапшот үнэ
  quantity  Int
}
