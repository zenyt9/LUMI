// Lumi гоо сайхны дэлгүүрийн өгөгдлийн загвар
// Production: PostgreSQL (Neon). DATABASE_URL орчны хувьсагчаар холбоно.
// role/status-г String-ээр хадгална (хялбар, шилжихэд эвтэйхэн).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       String    @id @default(cuid())
  name     String // жишээ: "Арьс арчилгаа"
  slug     String    @unique
  image    String?
  products Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String // жишээ: "The Ordinary"
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Int // үнэ ₮ (бүхэл тоо)
  oldPrice    Int? // хямдралын өмнөх үнэ (заавал биш). price-аас их бол хямдрал харагдана
  image       String
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?      @relation(fields: [brandId], references: [id])
  orderItems  OrderItem[]
  reviews     Review[]
  favorites   Favorite[]
  ratingSum   Int         @default(0) // үнэлгээний нийлбэр (дундажийг хурдан бодоход)
  ratingCount Int         @default(0) // үнэлгээ өгсөн тоо
  createdAt   DateTime    @default(now())
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("USER") // "USER" | "ADMIN"
  points       Int        @default(0) // нийт цуглуулсан оноо (ТҮВШИН тодорхойлно, буурдаггүй)
  pointsBalance Int       @default(0) // зарцуулах боломжтой оноо (хямдралд ашиглахад буурна)
  phone        String? // холбоо барих утас (checkout-д урьдчилж бөглөнө)
  orders       Order[]
  reviews      Review[]
  favorites    Favorite[]
  createdAt    DateTime   @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1-5 од
  comment   String?
  createdAt DateTime @default(now())

  @@unique([productId, userId]) // нэг хэрэглэгч нэг бараанд нэг л үнэлгээ
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  status       String      @default("PENDING") // PENDING | PAID | SHIPPED | DELIVERED | CANCELLED
  total        Int // эцсийн төлбөр (барааны дүн - хөнгөлөлт + хүргэлт)
  discount      Int        @default(0) // түвшингийн хөнгөлөлт
  pointsRedeemed Int       @default(0) // зарцуулсан оноо (цуцлахад буцаана)
  pointsDiscount Int       @default(0) // оноогоор хассан дүн (₮)
  shipping     Int         @default(0) // хүргэлтийн хураамж
  pointsEarned Int         @default(0) // хүргэгдсэн үед олгосон оноо (давхар олгохгүйн тулд)
  // Хүргэлтийн мэдээлэл
  fullName     String
  phone        String
  address      String
  note         String?
  items        OrderItem[]
  createdAt    DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // снапшот (бараа устгагдсан ч захиалга бүрэн байх)
  price     Int // снапшот үнэ
  quantity  Int
}
