# ===== Lumi орчны хувьсагчид =====
# Энэ файлыг хуулж .env болгоод утгуудаа бөглөнө.

# PostgreSQL холболт (Neon-оос авна)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js нууц түлхүүр — заавал шинээр үүсгэх: npx auth secret
AUTH_SECRET="энд-санамсаргүй-урт-нууц-утга"
AUTH_TRUST_HOST=true
